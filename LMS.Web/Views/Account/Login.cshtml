@model LoginForm
@{ ViewData["Title"] = "Sign in"; }
<h1>Sign in</h1>
<form action="/account/login" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" role="alert"></div>
    <p><label for="email">Email</label><input id="email" name="Email" type="email" value="@Model.Email" required autocomplete="username" maxlength="254" /></p>
    <p><label for="password">Password</label><input id="password" name="Password" type="password" required autocomplete="current-password" maxlength="1024" /></p>
    <button type="submit">Sign in</button>
</form>
<p><a href="/account/forgot-password">Forgot password?</a></p>
<p>New accounts require an organization invitation.</p>
