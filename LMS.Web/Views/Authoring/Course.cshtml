@model CourseEditor
<h1>@(Model.CourseId.HasValue ? "Edit course" : "Create course")</h1>
@if(Model.Choices is { } choices){
<form method="get"><label for="instructorSearch">Find an Instructor before entering course details</label><input id="instructorSearch" name="instructorSearch" value="@choices.Search" maxlength="100" /><button>Filter Instructors</button></form>
<p>@choices.Total matching Instructors, page @choices.Page. Changing this filter reloads the course form.</p>
@if(choices.Page>1){<a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString($"/staff/{Model.OrganizationId}/courses/new",new Dictionary<string,string?>{["instructorPage"]=(choices.Page-1).ToString(),["instructorSearch"]=choices.Search})">Previous Instructors</a>}
@if((long)choices.Page*choices.PageSize<choices.Total && choices.Page<10000){<a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString($"/staff/{Model.OrganizationId}/courses/new",new Dictionary<string,string?>{["instructorPage"]=(choices.Page+1).ToString(),["instructorSearch"]=choices.Search})">Next Instructors</a>}
}
<form method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="All"></div>
<p><label asp-for="Form.Title"></label><input asp-for="Form.Title" /></p>
<p><label asp-for="Form.Code"></label><input asp-for="Form.Code" /></p>
<p><label asp-for="Form.Description"></label><textarea asp-for="Form.Description"></textarea></p>
<p><label asp-for="Form.CategoryId">Category</label><select asp-for="Form.CategoryId"><option value="">None</option>
@foreach(var category in Model.Categories.Where(x=>x.IsActive||x.Id==Model.Form.CategoryId)) { <option value="@category.Id">@category.Name @(category.IsActive?"":"(inactive: choose another category)")</option> }
</select></p>
<p><label asp-for="Form.Level"></label><select asp-for="Form.Level"><option value="1">Beginner</option><option value="2">Intermediate</option><option value="3">Advanced</option></select></p>
<p><label asp-for="Form.DurationInMinutes">Duration (minutes)</label><input asp-for="Form.DurationInMinutes" min="0" /></p>
<p><label asp-for="Form.ThumbnailUrl">Thumbnail URL</label><input asp-for="Form.ThumbnailUrl" /></p>
@if(!Model.CourseId.HasValue && Model.IsAdmin) {
<p><label asp-for="Form.InstructorId">Instructor</label><select asp-for="Form.InstructorId"><option value="">Select Instructor</option>
@foreach(var member in Model.Instructors) { <option value="@member.UserId">@member.FirstName @member.LastName @member.Email (@member.UserId)</option> }
</select></p>
} else if(!Model.CourseId.HasValue) { <p>The course will be assigned to you.</p> }
else if(Model.IsAdmin) { <p><a href="/admin/@Model.OrganizationId/courses/@Model.CourseId/instructor">Manage Instructor assignment</a></p> }
<button type="submit">Save course</button>
</form>
<a href="/staff/@Model.OrganizationId/courses">Courses</a>
