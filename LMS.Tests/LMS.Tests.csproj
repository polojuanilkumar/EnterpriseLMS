    <Compile Include="../LMS.Api/Controllers/LessonsController.cs" Link="Api/LessonsController.cs" />
    <Compile Include="../LMS.Api/Controllers/QuizQuestionsController.cs" Link="Api/QuizQuestionsController.cs" />
    <Compile Include="../LMS.Api/Controllers/QuizAttemptsController.cs" Link="Api/QuizAttemptsController.cs" />
    <Compile Include="../LMS.Api/Controllers/AssignmentsController.cs" Link="Api/AssignmentsController.cs" />
    <Compile Include="../LMS.Api/Controllers/ReportsController.cs" Link="Api/ReportsController.cs" />
    <Compile Include="../LMS.Api/Controllers/GradebookController.cs" Link="Api/GradebookController.cs" />
  </ItemGroup>
